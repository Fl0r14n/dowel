{
  "name": "dowel-di",
  "version": "1.0.0",
  "description": "Tiny token-based DI with no registration step. Per-request containers, lazy defaults, vue and react bindings. Zero deps, SSR-safe.",
  "license": "MIT",
  "author": "Florian Chiș",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fl0r14n/dowel.git"
  },
  "homepage": "https://github.com/Fl0r14n/dowel#readme",
  "bugs": "https://github.com/Fl0r14n/dowel/issues",
  "keywords": [
    "di",
    "dependency-injection",
    "ioc",
    "inject",
    "provide",
    "container",
    "ssr",
    "vue",
    "react",
    "typescript",
    "zero-dependency"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "// typesVersions": "subpath types for legacy (node10) resolution, which ignores `exports`",
  "typesVersions": {
    "*": {
      "vue": [
        "./dist/vue.d.cts"
      ],
      "react": [
        "./dist/react.d.cts"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "check": "bun run lint && bun run type-check && bun run test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "jsdom": "^28.0.0",
    "publint": "^0.3.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  }
}
